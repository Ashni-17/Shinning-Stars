git status# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/stocksense
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Nodemailer (used to send OTP emails for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
